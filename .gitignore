# =============================================================================
# tech-news-graphrag — .gitignore
# =============================================================================

# ---------- Secrets & environment ----------
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ---------- Data (large / generated) ----------
data/raw/*
data/processed/articles/*
data/processed/chunks/*
data/processed/entities/*
data/processed/relationships/*
!data/raw/.gitkeep
!data/processed/articles/.gitkeep
!data/processed/chunks/.gitkeep
!data/processed/entities/.gitkeep
!data/processed/relationships/.gitkeep

# Keep evaluation ground-truth but ignore result outputs
data/evaluation/results/
*.jsonl.bak

# ---------- Logs ----------
logs/
*.log
log/

# ---------- IDE & editor ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Docker volumes / local infra ----------
.docker/
postgres_data/
neo4j_data/
neo4j_logs/
neo4j_import/
neo4j_plugins/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb

# ---------- Node (if any tooling) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Misc ----------
.cache/
tmp/
temp/
scratch/
