# =============================================================================
# tech-news-graphrag — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphrag
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Embedding Model
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai       # openai | huggingface | sentence-transformers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=512

# -----------------------------------------------------------------------------
# LLM (Generation)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai             # openai | anthropic | google | ollama
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Google Gemini (optional)
GOOGLE_API_KEY=

# Ollama base URL (optional, for local models)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
VECTOR_TOP_K=20
GRAPH_TOP_K=10
RERANK_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# Data Ingestion
# -----------------------------------------------------------------------------
DATASET_NAME=cc_news
DATASET_SPLIT=train
ARTICLES_LIMIT=5000
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# -----------------------------------------------------------------------------
# Graph Extraction
# -----------------------------------------------------------------------------
ENTITY_TYPES=Person,Organization,Location,Technology,Product,Event
MAX_ENTITIES_PER_CHUNK=20
GRAPH_EXTRACTION_BATCH_SIZE=16

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=


HF_TOKEN=your key here